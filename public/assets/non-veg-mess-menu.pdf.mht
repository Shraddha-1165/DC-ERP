@charset "utf-8";

.icon-color-custom-primary .kd-color-icon-secondary { fill: var(--kd-color-icon-primary,#333); stroke: var(--kd-color-icon-primary,#333); }

.pdf-container { height: 100%; overflow: hidden; display: flex; flex-direction: column; position: relative; }

.pdf-container .pdf-dashboard { flex: 1 1 0%; direction: ltr; width: 100%; overflow: auto; z-index: 0; touch-action: auto !important; }

.pdf-container .pdf-dashboard.scroller-disabled { pointer-events: none; }

.pdf-container .pdf-dashboard.visible { visibility: hidden; }

.pdf-container .pdf-dashboard.hidecmb { top: 0px !important; }

.pdf-container .pdf-dashboard::-webkit-scrollbar { display: none; }

.pdf-container .pdf-dashboard.show-cmd-banner { position: relative; top: 38px; }

.pdf-container.hide-cmb .bottom-tool-panel, .pdf-container.hide-cmb .header-wrap, .pdf-container.ready::before { display: none; }

.pdf-container::before { content: " "; position: absolute; z-index: 1; left: 0px; top: 0px; width: 100%; height: 100%; background: rgb(255, 255, 255); }

.iphoneX .show-search-bar { height: calc(100% - 85.5px) !important; }

.iphoneX .show-anno-bar { height: calc(100% - 122px) !important; }

.m-pdf-component-header.hidden { visibility: hidden; }

.pdf-fullbox { position: absolute; inset: 0px; overflow: hidden; }

.m-component-dropdown-popup, .meeting-control-wrap { z-index: 2000 !important; }

.mobile .component-toast .component-toast-content .toast-icon { display: none; }

.pdf-container.singlePageMode .pdf-dashboard .scroller-scrollbar { opacity: 0 !important; }

.pdf-container.singlePageMode .pdf-dashboard .pdf-page-wrapper .pdf-page { opacity: 0; }

.pdf-container.singlePageMode .pdf-dashboard .pdf-page-wrapper .pdf-page.singlePage-current { opacity: 1; }

.pdf-container.sheepColorMode { background: rgb(245, 240, 222); }

.pdf-container.sheepColorMode::before { content: ""; opacity: 1; position: absolute; display: inline-block; inset: 0px; background: rgb(228, 221, 195); z-index: 1; mix-blend-mode: exclusion; filter: invert(1); pointer-events: none; }

.pdf-container.eyesColorMode { background: rgb(233, 243, 225); }

.pdf-container.eyesColorMode::before { content: ""; opacity: 1; position: absolute; display: inline-block; inset: 0px; background: rgb(210, 226, 199); z-index: 1; mix-blend-mode: exclusion; filter: invert(1); pointer-events: none; }

.pdf-container.sunColorMode { background: rgb(240, 229, 212); }

.pdf-container.sunColorMode::before { content: ""; opacity: 1; position: absolute; display: inline-block; inset: 0px; background: rgb(252, 242, 227); z-index: 1; mix-blend-mode: exclusion; filter: invert(1); pointer-events: none; }

.pdf-container.darkColorMode { background: rgb(206, 206, 206); }

.pdf-container.darkColorMode::before { content: ""; opacity: 1; position: absolute; display: inline-block; inset: 0px; background: rgb(206, 206, 206); z-index: 1; mix-blend-mode: exclusion; filter: invert(1); pointer-events: none; }

[dir="rtl"] .component-clipboard { position: fixed; }

